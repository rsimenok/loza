          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensure that the target host is running a compatible Transmission RPC daemon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrese de que el host de destino ejecute un demonio Transmission RPC compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que l'hôte cible exécute un démon RPC Transmission compatible."
